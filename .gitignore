# API keys / secrets — never commit
a.json
.gitignore

.git*
# ...but DO track the line-ending policy (overrides core.autocrlf; stops CRLF phantom diffs)
!.gitattributes

# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/

# IDE
.idea/
.vscode/

# OS
Thumbs.db
.DS_Store

# Claude Code local settings + secrets
.claude/.env
.claude/settings.local.json

# Local date-wise agent backups (snapshot-before-edit; git history is the real backup)
.claude/agent-backups/

# Legacy / unrelated secrets file (lives under archive/unrelated/)
archive/unrelated/a.json

# Local plan / scratch files written by the agent (root-level only)
/PLAN.md

# Local reference copies of personal library data and command logs
# (the live files at C:\Media\*.json are the source of truth; these are snapshots)
resources/

# Git credentials (defensive — in case any local helper writes one)
.git-credentials
*.token
.candidates/

dummy_size_test/
dummy_size_test_mp4/

# Obsidian vault config (notes app used only to read the .md files — not a project file)
.obsidian/

# Obsidian loose artifacts written at the repo root (canvases, bases, date-named daily notes).
# Scoped patterns only — never a broad *.md (root docs like ARCHITECTURE.md are tracked).
*.canvas
*.base
/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9].md

# Local command-caveat transcript dumps written at the repo root by interactive runs
*local-command-caveat*.txt

